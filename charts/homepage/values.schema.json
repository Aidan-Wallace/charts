{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
        "affinity": {
            "type": "object"
        },
        "appEntryBuilder": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "image": {
                    "type": "object",
                    "properties": {
                        "pullPolicy": {
                            "type": "string"
                        },
                        "repository": {
                            "type": "string"
                        },
                        "tag": {
                            "type": "string"
                        }
                    }
                },
                "logLevel": {
                    "type": "string"
                },
                "resources": {
                    "type": "object"
                },
                "sleepIterationSeconds": {
                    "type": "integer"
                }
            }
        },
        "config": {
            "type": "object",
            "properties": {
                "allowedHosts": {
                    "type": "string"
                },
                "configMap": {
                    "type": "object",
                    "properties": {
                        "bookmarks.yaml": {
                            "type": "string"
                        },
                        "custom.css": {
                            "type": "string"
                        },
                        "custom.js": {
                            "type": "string"
                        },
                        "docker.yaml": {
                            "type": "string"
                        },
                        "kubernetes.yaml": {
                            "type": "string"
                        },
                        "proxmox.yaml": {
                            "type": "string"
                        },
                        "services.yaml": {
                            "type": "string"
                        },
                        "settings.yaml": {
                            "type": "string"
                        },
                        "widgets.yaml": {
                            "type": "string"
                        }
                    }
                },
                "extraFiles": {
                    "type": "array"
                },
                "provider": {
                    "type": "string"
                },
                "s3": {
                    "type": "object",
                    "properties": {
                        "accessKeyId": {
                            "type": "string"
                        },
                        "createSecret": {
                            "type": "boolean"
                        },
                        "image": {
                            "type": "object",
                            "properties": {
                                "pullPolicy": {
                                    "type": "string"
                                },
                                "repository": {
                                    "type": "string"
                                },
                                "tag": {
                                    "type": "string"
                                }
                            }
                        },
                        "region": {
                            "type": "string"
                        },
                        "resources": {
                            "type": "object"
                        },
                        "s3Path": {
                            "type": "string"
                        },
                        "secretAccessKey": {
                            "type": "string"
                        },
                        "secretName": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "fullnameOverride": {
            "type": "string"
        },
        "image": {
            "type": "object",
            "properties": {
                "pullPolicy": {
                    "type": "string"
                },
                "repository": {
                    "type": "string"
                },
                "tag": {
                    "type": "string"
                }
            }
        },
        "imagePullSecrets": {
            "type": "array"
        },
        "ingress": {
            "type": "object",
            "properties": {
                "annotations": {
                    "type": "object"
                },
                "auth": {
                    "type": "object",
                    "properties": {
                        "basicAuth": {
                            "type": "object",
                            "properties": {
                                "secretName": {
                                    "type": "string"
                                }
                            }
                        },
                        "enabled": {
                            "type": "boolean"
                        },
                        "type": {
                            "type": "string"
                        }
                    }
                },
                "className": {
                    "type": "string"
                },
                "enabled": {
                    "type": "boolean"
                },
                "hosts": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "host": {
                                "type": "string"
                            },
                            "paths": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "path": {
                                            "type": "string"
                                        },
                                        "pathType": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "tls": {
                    "type": "array"
                }
            }
        },
        "livenessProbe": {
            "type": "object",
            "properties": {
                "httpGet": {
                    "type": "object",
                    "properties": {
                        "path": {
                            "type": "string"
                        },
                        "port": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "nameOverride": {
            "type": "string"
        },
        "nodeSelector": {
            "type": "object"
        },
        "podAnnotations": {
            "type": "object"
        },
        "podLabels": {
            "type": "object"
        },
        "podSecurityContext": {
            "type": "object"
        },
        "readinessProbe": {
            "type": "object",
            "properties": {
                "httpGet": {
                    "type": "object",
                    "properties": {
                        "path": {
                            "type": "string"
                        },
                        "port": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "replicaCount": {
            "type": "integer"
        },
        "resources": {
            "type": "object"
        },
        "securityContext": {
            "type": "object"
        },
        "service": {
            "type": "object",
            "properties": {
                "port": {
                    "type": "integer"
                },
                "type": {
                    "type": "string"
                }
            }
        },
        "serviceAccount": {
            "type": "object",
            "properties": {
                "annotations": {
                    "type": "object"
                },
                "automount": {
                    "type": "boolean"
                },
                "clusterRoleBinding": {
                    "type": "object",
                    "properties": {
                        "create": {
                            "type": "boolean"
                        },
                        "roleName": {
                            "type": "string"
                        }
                    }
                },
                "create": {
                    "type": "boolean"
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "tolerations": {
            "type": "array"
        },
        "volumeMounts": {
            "type": "array"
        },
        "volumes": {
            "type": "array"
        }
    }
}
